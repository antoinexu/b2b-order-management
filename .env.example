NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://b2b:b2b@localhost:5432/b2b
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Replace the example below before using Docker or production; example secrets are rejected there.
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=8h
LOG_LEVEL=info
CORS_ORIGIN=*
# Per-IP limit for failed logins and for registrations within the window (default 10 per 15 minutes).
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Set to 1 when running behind a single reverse proxy / load balancer so client IPs are read correctly.
TRUST_PROXY=0
# Public URL of the web app; invitation and password reset links point here. Required in production when email is on.
APP_URL=http://localhost:5173
# Email (invitations, password resets). With no RESEND_API_KEY, development prints emails to the log and
# production disables these features. Options: resend | log | file | none.
# MAIL_TRANSPORT=log
# RESEND_API_KEY=re_...
# MAIL_FROM=B2B Orders <orders@your-verified-domain.com>
